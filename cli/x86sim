#!/bin/bash
# x86sim: command-line tools for x86Sim's phones (the iOS 27 arm64 simulator runtime on Darling + the arm64 JIT).
# Phones are started by the launcher (tools/launcher) or cli/libexec/arm64/boot-a64.sh.
# Configuration: x86sim.env in the repo root (see x86sim.env.example); environment variables override it.
# Run `x86sim help` for the commands. The scripts it wraps live in cli/libexec (and tools/debug, tests/).
set -u
self=$(readlink -f "$0")
export X86SIM_ROOT=${X86SIM_ROOT:-$(cd "$(dirname "$self")/.." && pwd)}
. "$X86SIM_ROOT/cli/lib/config.sh"
X=$X86SIM_ROOT; L=$X/cli/libexec; ST=$X86SIM_STATE

usage() {
	cat <<'U'
usage: x86sim <command> [args]

Phones
  wait [home|app] [s]  wait for the home screen (or an app page) on the framebuffer
  device models|list   arm64 device models (iPhone, iPad, Apple TV, Apple Watch) / devices (var/device-a64*)
  device create --model "iPhone 17 Pro" [name]
                       new arm64 device of that model (var/device-a64-<name>); boot it with A64_DEVICE=<dir>. An Apple TV
                       or Apple Watch model takes the newest tvOS / watchOS runtime in runtimes/
  runtime list [ios|tvos|watchos|all] | url B | fetch B
                       27.x simulator runtimes from Apple (no Mac / Apple ID): fetch downloads build B into runtimes/
  logs [label]         list the device's job logs, or tail one (<device>/data/var/log/<label>.log)

Display and input
  view [--bg]          GTK viewer window with mouse/keyboard input (simview.py; DISPLAY defaults to :0)
  screenshot [out.png] [divisor]
                       newest frame as PNG (fb2png.py; default ./x86sim-<time>.png, full size)
  tap X Y | swipe X1 Y1 X2 Y2 [ms] | pinch CX CY R1 R2 [ms] | pan2 X1 Y1 X2 Y2 [ms]
  type TEXT | key USAGE | home | lock | openurl URL | app BUNDLEID | dismiss [rounds] | raw LINE...
  crown DELTA [steps]  Apple Watch: turn the Digital Crown
                       input through the SimulatorHID stand-in (simtouch.py; device pixels). Apple TV: the arrow keys,
                       return (select) and escape (back) are the remote
  fps [secs]           delivered frames per second (fpsmeter.py)

Apps (as xcrun simctl install/uninstall/launch)
  install PATH.app     install an iOS-simulator app (arm64) through installd; it gets a container and an icon
  uninstall BUNDLEID   remove an installed app
  launch [--console|--console-pty] [-w|--wait-for-debugger] [--terminate-running-process] [--oslog] [--env K=V] BUNDLEID [args...]
                       open an app through FrontBoard with arguments and environment (SIMCTL_CHILD_NAME=value in
                       our environment -> NAME=value); --console streams its stdout/stderr here (files), --console-pty
                       through a pty (the app sees a terminal) (simctl.py)
  terminate BUNDLEID   stop a running app (FBSSystemService, as simctl terminate)
  get_app_container BUNDLEID [app|data|groups|GROUPID]
                       Linux path of the app's bundle / data container / app-group containers
  listapps [--json]    installed apps (LaunchServices), with type, name and bundle path
  push [BUNDLEID] PAYLOAD.json|-
                       simulated remote notification (as simctl push; "Simulator Target Bundle" in the payload)
  location set LAT,LON | clear | list | run SCENARIO
  location start|run [--speed=M/S] [--distance=M|--interval=S] LAT,LON LAT,LON...
                       simulated device location (CLSimulationManager -> locationd, as simctl location): one point,
                       a scenario (City Run, Freeway Drive, ...) or a route between waypoints (default 20 m/s, 1 s)
  addmedia FILE...     add photos/videos to the Photos library (as simctl addmedia)
  log stream [--app BUNDLEID] [--process NAME] [--match TEXT]
                       os_log of an app (relaunched; libsimshim formats os_log into a file) or of a process
  pidof BUNDLEID       pid of the running app (inside Darling)
  io screenshot [out.png] | io recordVideo [--codec h264|hevc] [--secs N] OUT.mp4
                       as simctl io: newest frame / MP4 from the frame ring until Ctrl-C

Build
  build [target]       make [target] in the repo root (mtlvk, darling, ...; see `make help`)

Repos (every submodule is a fork in the x86sim GitHub org; repos.sh)
  repos [status]       dirty / unpushed submodules
  repos commit -m MSG [--dry-run]
                       commit tracked changes in every dirty submodule (deepest first), push each, then commit
                       and push the bumped pointers in x86sim
  upstream-sync [--apply] [PATH...]
                       fetch each fork's GitHub parent and rebase our x86sim branch onto it (dry run reports
                       behind/ahead and conflicts; --apply rebases, force-with-lease pushes, aborts on conflict)
U
}

alive_pidfile() { [ -f "$1" ] && kill -0 "$(cat "$1")" 2>/dev/null; }

cmd_view() {
	export DISPLAY=${DISPLAY:-:0}
	if [ "${1:-}" = --bg ]; then
		if alive_pidfile "$ST/view.pid"; then echo "x86sim: viewer already running"; return 0; fi
		setsid python3 "$L/simview.py" > "$ST/view.log" 2>&1 < /dev/null &
		echo $! > "$ST/view.pid"; echo "x86sim: viewer started (pid $!, DISPLAY=$DISPLAY)"
	else
		exec python3 "$L/simview.py" "$@"
	fi
}

cmd_screenshot() {
	local out=${1:-./x86sim-$(date +%Y%m%d-%H%M%S).png}
	python3 "$L/fb2png.py" ring "$out" "${2:-1}" > /dev/null && echo "$out"
}

cmd_logs() {
	local d=$X86SIM_DEVICE/data/var/log
	if [ $# = 0 ]; then ls -t "$d"; else exec tail -n "${LINES:-50}" -F "$d/$1.log"; fi
}

[ $# -ge 1 ] || { usage; exit 2; }
c=$1; shift
case $c in
	help|-h|--help) usage ;;
	wait) exec python3 "$L/framecheck.py" wait "${1:-home}" "${2:-300}" ;;
	device) exec python3 "$L/arm64/device-a64.py" "$@" ;;
	runtime) exec python3 "$L/arm64/runtime-fetch.py" "$@" ;;
	logs) cmd_logs "$@" ;;
	view) cmd_view "$@" ;;
	screenshot|shot) cmd_screenshot "$@" ;;
	tap|swipe|pinch|pan2|key|home|lock|crown|openurl|app|dismiss|raw) exec python3 "$L/simtouch.py" "$c" "$@" ;;
	type|text) exec python3 "$L/simtouch.py" text "$*" ;;
	fps) exec python3 "$L/fpsmeter.py" "${1:-10}" ;;
	install|uninstall) exec "$L/appinstall.sh" "$c" "$@" ;;
	launch|terminate|get_app_container|listapps|push|location|addmedia|log|io|pidof)
		# simctl-style leading <device> (x86sim launch apps com.foo): a phone's name/folder/dir
		. "$X/cli/lib/pickdevice.sh"
		if [ $# -ge 1 ] && { [ $# -ge 2 ] || [ "$c" = listapps ]; } && pick_device "$1"; then shift; export X86SIM_DEVICE; fi
		exec python3 "$L/simctl.py" "$c" "$@" ;;
	build) exec make -C "$X" "$@" ;;
	repos) exec "$L/repos.sh" "$@" ;;
	upstream-sync) exec "$L/repos.sh" upstream-sync "$@" ;;
	*) echo "x86sim: unknown command $c" >&2; usage >&2; exit 2 ;;
esac
